# nginx auth — real credentials on VPS, empty placeholder for local dev (never commit)
infra/nginx/.htpasswd

# Dendrite homeserver — matrix_key.pem (signing identity) + dendrite.yaml (embeds DB
# password + registration_shared_secret) are real per-deployment secrets, never commit
infra/dendrite/config/matrix_key.pem
infra/dendrite/config/dendrite.yaml

